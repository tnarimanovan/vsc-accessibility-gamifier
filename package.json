{
  "name": "vsc-accessibility-gamifier",
  "displayName": "Accessibility Mole: Gamified A11y Assistant",
  "description": "Gamify your accessibility workflow with a cute virtual pet that evolves as you fix HTML/a11y errors.",
  "version": "0.0.1",
  "publisher": "tnarimanovan",
  "author": {
    "name": "tnarimanovan"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tnarimanovan/vsc-accessibility-gamifier.git"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "accessibility",
    "a11y",
    "gamification",
    "linter",
    "virtual-pet"
  ],
  "engines": {
    "vscode": "^1.120.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsc-accessibility-gamifier.openBurrow",
        "title": "Mole's Burrow: Open Burrow",
        "category": "Accessibility Gamifier"
      }
    ],
    "configuration": {
      "title": "Accessibility Mole",
      "properties": {
        "accessibilityMole.enableCodeHighlighting": {
          "type": "boolean",
          "default": true,
          "description": "Enable visual highlighting of lines with accessibility errors directly in the text editor."
        }
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vscode-test",
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && npm run compile && npx @vscode/vsce package",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.20",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "jsdom": "^29.1.1"
  }
}